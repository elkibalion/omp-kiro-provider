{
  "name": "omp-kiro-provider",
  "version": "0.1.0",
  "private": false,
  "description": "Oh My Pi extension provider for Kiro's AWS CodeWhisperer-compatible streaming API.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "lint": "node scripts/audit-terminal.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run --silent lint && npm run test && npm run build",
    "package:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "omp-package",
    "oh-my-pi",
    "omp-extension",
    "kiro",
    "provider",
    "ai-provider",
    "oauth",
    "codewhisperer",
    "amazon-q"
  ],
  "author": "MasuRii",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "^17.2.10",
    "@oh-my-pi/pi-catalog": "^17.2.10",
    "@oh-my-pi/pi-coding-agent": "^17.2.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^17.2.10",
    "@oh-my-pi/pi-catalog": "^17.2.10",
    "@oh-my-pi/pi-coding-agent": "^17.2.10",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0"
  }
}
